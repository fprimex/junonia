# List markdown documents, sorting with LC_ALL=C to ensure proper ordering.
junonia_doc_list () {
  ls -1 "$1"/*.md 2>/dev/null | LC_ALL=C sort
}

# Parse Markdown text into a program argument spec
_junonia_md2spec () {
  echodebug "begin md2spec"

  awk_prog='
    # Print the currently stored spec and reset for the next one.
    function spec () {
      echotrace("generating spec")
      if(junonia_web) {
        cmd = cmd ", junonia_web"
      }

      print indent cmd

      for(i=1; i<=n_params; i++) {
        print indent "  " params[i]
      }

      if(junonia_web) {
        print indent "  -JUNONIA_WEB_METHOD METHOD=" jw_method
        print indent "  -JUNONIA_CONTENT_TYPE TYPE=" jw_content_t
        print indent "  -JUNONIA_WEB_URL URL=" jw_url
      }

      if(output_text) {
        if(output_table == 1) {
          insert_jtable()
          output_table = 0
        }

        gsub(/\n/, "\\\\n", output_text)
        print indent "  -JUNONIA_OUTPUT OUTPUT=" output_text
      }

      if(junonia_web) {
        if(!output_text) {
          print indent "  -JUNONIA_OUTPUT OUTPUT="
        }
        print indent "  -json"
      }

      for(i=1; i<=n_opts; i++) {
        print indent "  " opts[i]
      }

      indent = ""
      cmd = ""
      output_text = ""
      n_params = 0
      n_opts = 0
      split("", params, ":")
      split("", opts, ":")
      junonia_web = 0
    }

    function md_to_jq(s, r, a, i) {
      echotrace("md_to_jq")
      n = split(s, a, /`/)
      for(i=1; i<=n; i++) {
        if(i % 2 == 1) {
          r = r a[i]
        } else {
          r = r "\\(" a[i] ")"
        }
      }
      sub(/  $/, "", r)
      return r
    }

    # A documented boolean default in the spec is 1 or 0. mapbool cannot be
    # used directly: it maps the empty string to true, and an empty default is
    # false.
    function boolspec(b, opt) {
      echotrace("boolspec")
      return mapbool(b, opt) == "1" ? "1" : "0"
    }

    function insert_jtable() {
      echotrace("inserting table")
      if(n_cols > n_headers) {
        root_element = rowa[n_cols-1]
        gsub(/`/, "", root_element)
        table_cols = table_cols "]"
      } else {
        root_element = "."
        table_cols = table_cols "," rowa[n_cols-1] "]"
      }

      manual_fmt = 0
      for(i=2; i<n_headers; i++) {
        echodebug("header: " headersa[i])
        echodebug("row: " rowa[i])

        h = headersa[i]
        r = rowa[i]
        hlen = length(h)
        rlen = length(r)
        sub(/^ */, "", h)
        sub(/ *$/, "", h)
        sub(/^ */, "", r)
        sub(/ *$/, "", r)
        hstriplen = length(h)
        rstriplen = length(r)

        echodebug("hlen: " hlen)
        echodebug("rlen: " rlen)
        echodebug("hstriplen: " hstriplen)
        echodebug("rstriplen: " rstriplen)

        if(hstriplen > rstriplen) {
          if(substr(headersa[i], hlen) == " ") {
            manual_fmt = 1
            break
          }
        } else {
          echodebug(substr(rowa[i], rlen))
          if(substr(rowa[i], rlen) == " ") {
            manual_fmt = 1
            break
          }
        }
      }
      echodebug("manual_fmt: " manual_fmt)

      gsub(/`/, "\"", table_cols)

      if(! manual_fmt) {
        gsub(" *" jfs "|$", "", table_headers)
      }

      if(output_text) {
        output_text = output_text "\n" SOH
      } else {
        output_text = SOH
      }

      output_text = output_text "\n" "junonia_format_jtable"
      output_text = output_text "\n" STX
      output_text = output_text "\n\",\"" "\\(jtable({\"element\":" root_element ",\"columns\":" table_cols "}))\",\"" JRS
      output_text = output_text "\n" ETX
      output_text = output_text "\n" STX
      output_text = output_text "\n" table_headers
      output_text = output_text "\n" ETX
      output_text = output_text "\n" EOT
      output_text = output_text "\n"
    }

    # When encountering a header, leave any header we were in.
    /^#/ {
      echotrace("matched #")
      if(output_table == 1) {
        insert_jtable()
        sub(JRS, "", output_text)
      }

      synopsis = 0
      positional = 0
      options = 0
      endpoint = 0
      content_type = 0
      output = 0
      output_icode = 0
      output_tcode = 0
      output_table = 0
    }

    # Top level ## header
    # ## `command subcommand`
    /^## `[-,_A-Za-z0-9 ]+`/ {
      echotrace("matched ##")
      if(cmd) {
        spec()
      }

      # Strip everything around the title
      gsub(/^## `|`$/, "")

      # Empty the list first
      split("", subcmds, ":")

      # Split on commas to get the first part plus the aliases
      sn = split($0, subcmda, ",")

      # Split the first part and get the last item to get the primary subcmd
      pn = split(subcmda[1], primary_subcmd)

      # Put that primary subcommand in the first command slot
      cmd = primary_subcmd[pn] ","

      # Add the command aliases
      for(i=2; i<=sn; i++) {
        # Normalize the entries to have a comma on the end
        sub(/,+$/, ",", subcmda[i])
        cmd = cmd subcmda[i]
      }

      # Strip the last trailing comma
      sub(/,$/, "", cmd)

      indent = ""
      for(i=1; i<pn; i++) {
        indent = indent "  "
      }
    }

    /^### REST endpoint/ {
      echotrace("matched ### REST")
      endpoint = 1
      next
    }

    endpoint && /^    [A-Z]+ http/ {
      echotrace("matched endpoint method and url")
      junonia_web = 1
      jw_method = $1
      jw_url = $2
      jw_content_t = ""
      next
    }

    /^### Content type/ {
      echotrace("matched content type header")
      content_type = 1
      next
    }

    content_type && /^    [^\/]+\/[^\/]+/ {
      echotrace("matched content type")
      jw_content_t = $1
    }

    /^### Positional parameters/ {
      echotrace("matched ### Positional")
      positional = 1
      next
    }

    # * `POS_ONE`
    positional && /^\* `[-_A-Z0-9]+`/ {
      echotrace("matched positional parameter")
      gsub(/^\* `|`$/, "")
      params[++n_params] = $0
      param = 1
      next
    }

    positional && /\[default: `.*`\]$/ {
      echotrace("matched positional parameter default")
      match($0, /\[default: `.*`\]$/)
      def = substr($0, RSTART+12, RLENGTH-12-2)
      params[n_params] = params[n_params] "=" def
    }

    /^### Options/ {
      echotrace("matched ### Options")
      options = 1
    }

    # A flag is idenfied by nothing coming after it
    # * `-option`
    #
    # A normal option
    # * `-option VAL`
    #
    # An option with an alias
    # * `-o, -option VAL`
    #
    # An option that can be repeated
    # * `-option VAL1 [-option VAL2 ...]`
    options && /^\* `-[-A-Za-z0-9]+/ {
      echotrace("matched option")

      # Remove the leading bullet-space-backtick and the last backtick
      gsub(/^\* `|`$/, "")

      # Options can have aliases. The definitive one is the last one, so loop
      # through the option names until the last one is reached.
      opt = ""
      while(match($0, /^-[-_A-Za-z0-9]+/)) {
        opt = opt substr($0, RSTART, RLENGTH) ","
        $0 = substr($0, RLENGTH + 1)
        sub(/^ *, */, "")
      }

      opt = substr(opt, 1, length(opt) - 1)

      # A default written as part of the name, as in `-flag=1`, marks a
      # boolean, so peel it off before the rest is read as a meta variable.
      inline_def = ""
      has_inline_def = 0
      if(substr($0, 1, 1) == "=") {
        has_inline_def = 1
        inline_def = boolspec(substr($0, 2), opt)
        $0 = ""
      }

      opts[++n_opts] = opt

      sub(/^ */, "")
      n_metas = split($0, a, " ")
      if(n_metas == 1) {
        # Only meta variable; not repeatable option
        opts[n_opts] = opts[n_opts] " " a[1]
      } else {
        if(n_metas > 1) {
          # More items after meta variable; multi-option
          opts[n_opts] = opts[n_opts] " [" a[1] "]"
        }
      }

      if(has_inline_def) {
        opts[n_opts] = opts[n_opts] "=" inline_def
      }
    }

    options && /^\* `\.[-A-Za-z0-9]+/ {
      echotrace("matched json option")
      # Remove the leading bullet-space-backtick and the last backtick
      gsub(/^\* `|`$/, "")

      # The default rule below depends on opt and n_metas, so set them the way
      # the option rule above does.
      split($1, jn, "=")
      opt = jn[1]
      opts[++n_opts] = $1

      if($2 ~ /[-_A-Z0-9]+/) {
        opts[n_opts] = opts[n_opts] " " $2
        n_metas = 1
      } else {
        n_metas = 0
      }
    }

    options && /\[default: `.*`\]$/ {
      echotrace("matched option default")
      match($0, /\[default: `.*`\]/)
      def = substr($0, RSTART+11, RLENGTH-11-2)

      if(n_metas == 0) {
        # This was previously determined to be a flag, so the default needs
        # to be processed and mapped to a spec bool value.
        def = boolspec(def, opt)
      }

      opts[n_opts] = opts[n_opts] "=" def
    }

    /^### Output/ {
      echotrace("matched ### Output")
      output = 1
      next
    }

    output && /^    / {
      echotrace("matched output indented code")
      output_icode = 1
    }

    output_icode && ( /^    / || /^$/ ) {
      echotrace("matched output empty line")
      sub(/^    /, "")
      output_text = output_text "\n" $0
      next
    }

    output_icode && ! (/^$/ || /^    /) {
      echotrace("matched output indented code exit")
      output_icode = 0
    }

    output_tcode && /^```/ {
      echotrace("matched output backticks code exit")
      output_tcode = 0
      next
    }

    output && /^```/ {
      echotrace("matched output backticks code")
      output_tcode = 1
      next
    }

    output_tcode {
      echotrace("matched output backticks line")
      output_text = output_text "\n" $0
      next
    }

    output_table && /^\|[- \|]+$/ {
      echotrace("matched output table divider row")
      next
    }

    output_table && /^\|/ {
      echotrace("matched output table row")
      n_cols = split($0, rowa, /\|/)

      sub(/^ /, "", rowa[2])
      sub(/ $/, "", rowa[2])
      table_cols = "[" rowa[2]

      for(i=3; i<n_cols-1; i++) {
        sub(/^ /, "", rowa[i])
        sub(/ $/, "", rowa[i])
        table_cols = table_cols "," rowa[i]
      }

      sub(/^ /, "", rowa[n_cols-1])
      sub(/ $/, "", rowa[n_cols-1])

      next
    }

    output_table && /^$/ {
      echotrace("matched output table exit")
      insert_jtable()
      output_table = 0
      next
    }

    output && /^\|/ {
      echotrace("matched output table")
      output_table = 1
      table_headers = ""
      table_cols = ""

      n_headers = split($0, headersa, /\|/)

      sub(/^ /, "", headersa[2])
      sub(/ $/, "", headersa[2])
      table_headers = headersa[2]

      for(i=3; i<n_headers; i++) {
        sub(/^ /, "", headersa[i])
        sub(/ $/, "", headersa[i])
        table_headers = table_headers JFS headersa[i]
      }

      next
    }

    output && output_text {
      echotrace("matched append any jq to existing output")
      output_text = output_text "\n" md_to_jq($0)
      next
    }

    output {
      echotrace("matched set output to any jq")
      output_text = md_to_jq($0)
      next
    }

    END {
      echotrace("matched END")
      if(output_table == 1) {
        insert_jtable()
        sub(JRS, "", output_text)
        output_table = 0
      }

      spec()
    }
  '

  awk -v wrap="$JUNONIA_WRAP" -v col1="$JUNONIA_COL1" \
      -v col2="$JUNONIA_COL2" \
      -v SOH="$JSOH" -v STX="$JSTX" -v ETX="$JETX" -v EOT="$JEOT" \
      -v JUS="$JUS"  -v JRS="$JRS"  -v JFS="$JFS" \
      "$JUNONIA_AWKS $awk_prog" "$@"
}

# Parse Markdown text into command line help
_junonia_md2help () {
  echodebug "begin md2help"

  awk_prog='
    BEGIN {
      echodebug("cmd: " cmd)

      # Split the supplied command into an array of parts
      n_cmd_parts = split(cmd, cmda)
      echodebug("n_cmd_parts: " n_cmd_parts)

      # How far into the command path the documentation search has got; help
      # begins once every part has matched a title.
      subcmd_level = 1

      # Subcommands of the command being documented, which are summarized at
      # the end of its help.
      subcmd_re = "^" cmd " [-_A-Za-z0-9]+$"
      echodebug("  subcmd regex: " subcmd_re)

      col1_indent = sprintf("%" col1 "s", "")
      txt = "NAME\n"
      subcmd_txt = "SUBCOMMANDS\n"
    }

    # When encountering a header, leave any header we were in.
    /^#/ {
      if(positional_no_desc) {
        txt = txt twocol(param_col1, "", col1 - 3, col2, " ", "  ") "\n"
      }

      # When leaving a header and processing docs, add a separating newline
      # (e.g. between the last line of description and start of OPTIONS)
      # but only if text was added when passing through a section
      if(cmd_doc_start && added_txt) {
        txt = txt "\n"
      }


      title = 0
      synopsis = 0
      description = 0
      positional = 0
      options = 0
      added_txt = 0
      positional_no_desc = 0
    }

    # Top level "##" header
    # ## `command subcommand`
    /^## / {
      echodebug("entering " $0)

      # Strip everything around the title
      gsub(/^## `|`$/, "")
      title = 1

      # If help docs have started, this signals the end of processing the
      # non-subcommand documentation.
      if(cmd_doc_start) {
        cmd_doc_start = 0
        cmd_doc_end = 1
        echodebug("end command documentation")
      }

      # Smush the aliases together to make them grouped when split on spaces.
      # Every alias needs smushing, not just the first one.
      gsub(/, +/, ",")
      gsub(/ +,/, ",")

      # Extract the commands, subcommands, and aliases in this header
      split("", subcmds, ":")
      hn = split($0, subcmds)

      # Extract aliases as keys (array indices) so it can be checked with an
      # "in" expression later. Also, need to empty the array first.
      split("", aliases, ":")
      an = split(subcmds[hn], aliases, ",")
      for(j=1; j<=an; j++) {
        aliases[aliases[j]] = ""
        delete aliases[j]
      }
    }

    # Find the topmost level command title to bootstrap subcommand location.
    title && subcmd_level == 1 && $0 == cmda[1] {
      # The top level command; the name of the program.
      cmd_part = cmda[1]

      echodebug("top level command: " cmd_part)

      # Increment the level of subcommand we are interested in.
      subcmd_level = 2

      # This is the only command given; help for the program itself. So
      # actually we are done searching for the command to do help for. Note
      # that the name itself is added to the help text by the rule that finds
      # the whole command, which runs on the line following this header.
      if(n_cmd_parts == 1) {
        cmd_doc_start = 1
        added_txt = 1
        echodebug("start command documentation")
      }

      next
    }

    # A title holding the whole command locates it without also needing a title
    # for the program itself, as when only the documentation of one command is
    # streamed.
    title && subcmd_level == 1 && $0 == cmd {
      cmd_part = $0
      subcmd_level = n_cmd_parts + 1
      echodebug("whole command located: " cmd_part)
      next
    }

    # Keep moving until the top level command is located
    subcmd_level == 1 {
      next
    }

    # At this point subcmd_level > 1

    # A title holding the whole command. The depth has to match exactly, or a
    # deeper command is treated as found when only its leading parts matched.
    title && subcmd_level <= n_cmd_parts && n_cmd_parts == hn && cmda[subcmd_level] == subcmds[subcmd_level] {
      # Every part of the command has to match up
      for(j=1; j<=n_cmd_parts; j++) {
        if(cmda[j] != subcmds[j]) {
          next
        }
      }

      # This is the header line with all Markdown stripped
      cmd_part = $0

      # Every part of the command has now been located
      subcmd_level = n_cmd_parts + 1
      echodebug("whole command located: " cmd_part)
      next
    }

    # The whole command has been found, so document it and get set up to
    # identify and document the subcommand summary
    title && subcmd_level == n_cmd_parts + 1 && n_cmd_parts == hn && cmda[n_cmd_parts] in aliases {
      # Everything up to this point has to match up also
      for(j=1; j<subcmd_level; j++) {
        if(cmda[j] != subcmds[j]) {
          next
        }
      }

      # Unsmush any aliases
      sub(/,/, ", ", cmd_part)

      txt = txt "  " cmd_part "\n"
      added_txt = 1

      cmd_doc_start = 1
      echodebug("start command documentation")
      subcmd_level++
      next
    }

    # Keep moving until the whole command is located.
    subcmd_level <= n_cmd_parts {
      next
    }

    # First line of the description, appended to the name line. Only after the
    # whole command is located, or text of an unrelated title lands here.
    title && cmd_doc_start && ! cmd_doc_end && ! /^$/ {
      txt = substr(txt, 1, length(txt) - 1) " -- " $0 "\n"
      added_txt = 1
      next
    }

    # Collect this subcommand. If it has aliases, extract the primary command.
    title && $0 ~ subcmd_re {
      n_subcmds++
      split($0, subcmda, ",")
      pn = split(subcmda[1], primary_subcmd)
      subcmd = primary_subcmd[pn]
      next
    }

    # Leaving this subcommand title without a description
    subcmd && /^#/ {
      subcmd_txt = subcmd_txt "  " subcmd "\n"
      subcmd = ""
      next
    }

    # Subcommand title block with a description
    subcmd && ! /^$/ {
      subcmd_txt = subcmd_txt twocol(subcmd, $0, col1 - 3, col2, " ", "  ") "\n"
      subcmd = ""
      next
    }

    # Not seen the right command or have processed it already, so none of the
    # below processing should be done. All that remains is collecting
    # subcommands.
    ! cmd_doc_start || cmd_doc_end {
      next
    }

    /^### Synopsis/ {
      synopsis = 1
      txt = txt "SYNOPSIS\n"
      added_txt = 1
      next
    }

    synopsis && /^    [a-z]/ {
      sub(/^    /, "  ")
      syn = $0
      txt = txt $0 "\n"
      added_txt = 1
    }

    /^### REST endpoint/ {
      junonia_web = 1
      txt = txt "REST ENDPOINT\n"
      added_txt = 1
      next
    }

    junonia_web && /^    [A-Z]+  *http/ {
      sub(/^    /, "  ")
      txt = txt $0 "\n"
      added_txt = 1
    }

    /^### Description/ {
      description = 1
      txt = txt "DESCRIPTION"
      added_txt = 1
      next
    }

    description && ! /^$/ {
      txt = txt "\n" hardwrap($0, wrap - 2, "  ") "\n"
      added_txt = 1
    }

    /^### Positional parameters/ {
      positional = 1
      txt = txt "PARAMETERS\n"
      added_txt = 1
      next
    }

    #* `POS_ONE`
    positional && /^\* `[-_A-Z0-9]+`/ {
      gsub(/`/, "")
      param_col1 = $2
      positional_no_desc = 1
    }

    positional && /^[A-Za-z0-9]/ {
      txt = txt twocol(param_col1, $0, col1 - 3, col2, " ", "  ") "\n"
      positional_no_desc = 0
      added_txt = 1
    }

    /^### Options/ {
      options = 1
      txt = txt "OPTIONS\n"
      added_txt = 1
      next
    }

    #* `-option`
    #* `-option VAL`
    #* `-option VAL1 [-option1 VAL2 ...]`
    options && /^\* `[\.-][-_A-Za-z0-9]+/ {
      gsub(/^\* |`/, "")
      opt_col1 = $0
    }

    options && /^[A-Za-z0-9]/ {
      if(length(opt_col1) > col1 - 3) {
        opt_col2 = hardwrap($0, wrap - col1, col1_indent)
        txt = txt "  " opt_col1 "\n" opt_col2 "\n\n"
        added_txt = 1
      } else {
        txt = txt twocol(opt_col1, $0, col1 - 3, col2, " ", "  ") "\n"
        added_txt = 1
      }
    }

    /^### Online documentation/ {
      online_doc = 1
      txt = txt "ONLINE DOCUMENTATION\n"
      added_txt = 1
      next
    }

    online_doc && /^http/ {
      txt = txt "  " $0 "\n"
      added_txt = 1
    }

    END {
      if(txt == "NAME\n") {
        echoerr("help documentation failed to be generated")
        exit 1
      }

      sub(/\n*$/, "", txt)
      print txt
      if(n_subcmds > 0) {
        print "\n" subcmd_txt
      }
    }
  '

  if [ -z "$1" ]; then
    echoerr "Command text required to generate help"
    return 1
  fi

  cat | awk -v wrap="$JUNONIA_WRAP" -v col1="$JUNONIA_COL1" \
            -v col2="$JUNONIA_COL2" -v cmd="$1" \
            "$JUNONIA_AWKS $awk_prog"
}


